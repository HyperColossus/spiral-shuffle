<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImlightDirectory Condition="'$(ImlightDirectory)' == ''">$(MSBuildThisFileDirectory)../.runtime/server</ImlightDirectory>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Imlight.CoreLib</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../.build/source/**/*.cs" />
    <Reference Include="$(ImlightDirectory)/Imcodec.*.dll" />
    <Reference Include="$(ImlightDirectory)/Imlight.Common.dll" />
    <Reference Include="$(ImlightDirectory)/Akka.dll" />
    <Reference Include="$(ImlightDirectory)/Akka.Remote.dll" />
    <Reference Include="$(ImlightDirectory)/Raven.Client.dll" />
    <Reference Include="$(ImlightDirectory)/Raven.Embedded.dll" />
    <Reference Include="$(ImlightDirectory)/Newtonsoft.Json.dll" />
    <Reference Include="$(ImlightDirectory)/LibGit2Sharp.dll" />
    <Reference Include="$(ImlightDirectory)/LiteDB.dll" />
    <Reference Include="$(ImlightDirectory)/Ionic.Zlib.Core.dll" />
    <Reference Include="$(ImlightDirectory)/BouncyCastle.Cryptography.dll" />
    <Reference Include="$(ImlightDirectory)/Serilog.dll" />
    <Reference Include="$(ImlightDirectory)/Sparrow.dll" />
    <Reference Include="$(ImlightDirectory)/Microsoft.Extensions.ObjectPool.dll" />
  </ItemGroup>
  <Target Name="MatchInstalledAssemblyVersion" BeforeTargets="GetAssemblyVersion">
    <GetAssemblyIdentity AssemblyFiles="$(ImlightDirectory)/Imlight.CoreLib.dll">
      <Output TaskParameter="Assemblies" ItemName="InstalledCoreLibrary" />
    </GetAssemblyIdentity>
    <PropertyGroup>
      <AssemblyVersion>%(InstalledCoreLibrary.Version)</AssemblyVersion>
    </PropertyGroup>
  </Target>
</Project>
