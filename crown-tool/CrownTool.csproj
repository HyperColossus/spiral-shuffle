<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ImlightDirectory Condition="'$(ImlightDirectory)' == ''">$(MSBuildThisFileDirectory)../.runtime/server</ImlightDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(ImlightDirectory)/Imcodec.*.dll" />
    <Reference Include="$(ImlightDirectory)/Imlight.Common.dll" />
    <ProjectReference Include="../server-build/Imlight.CoreLib.csproj" />
    <Compile Include="../asset-tool/BindDocument.cs" Link="BindDocument.cs" />
    <Compile Include="../asset-tool/CrownPricing.cs" Link="CrownPricing.cs" />
  </ItemGroup>
</Project>
