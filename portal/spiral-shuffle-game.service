[Unit]
Description=Spiral Shuffle game and patch supervision
Wants=network-online.target spiral-shuffle-portal.service
After=network-online.target docker.service

[Service]
Type=notify
NotifyAccess=main
User=spiral-shuffle
Group=spiral-shuffle
Environment=SPIRAL_DATA_DIR=@DATA_DIR@
WorkingDirectory=@ROOT@
ExecStart=/usr/bin/python3 @ROOT@/service_runtime.py
Restart=on-failure
RestartSec=5
TimeoutStartSec=240
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
