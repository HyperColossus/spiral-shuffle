[Unit]
Description=Spiral Shuffle GitHub Pages registration API
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/spiral-shuffle
EnvironmentFile=%h/spiral-shuffle/.runtime/portal/portal.env
ExecStart=/usr/bin/python3 %h/spiral-shuffle/portal_api.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
